# Local SQLite working database. The pipeline writes here through SQLAlchemy;
# `python -m pipeline.sync_d1` pushes it to Cloudflare D1. SQLite is the same
# dialect D1 speaks, so the schema is D1-compatible by construction.
DATABASE_URL=sqlite+pysqlite:///./data/hiring_db.sqlite3

# Phase 3: identifies this pipeline's HTTP requests in the User-Agent header sent to
# every source (politeness layer requirement). Falls back to a placeholder if unset.
PIPELINE_CONTACT_EMAIL=

# --- Cloudflare ---------------------------------------------------------------
# Account that owns the D1 database and R2 bucket. Also read by `wrangler`.
CLOUDFLARE_ACCOUNT_ID=ccae88e535ce0411f251dcd08737bf02
D1_DATABASE_NAME=hiring-db
D1_DATABASE_ID=70abc606-e937-4751-ac61-24ffd1b6f994

# --- R2 (raw_documents payload bodies) ----------------------------------------
# Mint these under R2 > Manage API tokens in the dashboard; wrangler's OAuth token
# cannot create them. Leave blank to use the on-disk fallback store at
# data/raw_store/ — the pipeline and the full test suite run fine without R2.
R2_BUCKET=hiring-db-raw
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Transcript extraction service (service/) ---------------------------------
# The Anthropic SDK reads the key from the environment itself — nothing in this
# repo ever reads or stores it. In production inject it from a secret manager, not
# from a .env file. With no key present the service still works: every upload
# falls back to rule-based regex extraction, and the startup log says so.
ANTHROPIC_API_KEY=

# Kill switch. Set to false to force the rule-based path without a redeploy.
LLM_EXTRACTION_ENABLED=true

ANTHROPIC_MODEL=claude-opus-5
# Quality/cost/latency dial: low | medium | high | xhigh | max.
ANTHROPIC_EFFORT=medium
# Caps thinking AND response tokens together — this model thinks by default, so
# leave headroom for both or a long course list will truncate.
ANTHROPIC_MAX_TOKENS=32000
# Worst-case wall clock is TIMEOUT * (MAX_RETRIES + 1). Keep under your ingress
# request timeout.
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_RETRIES=1
# Longer documents are truncated with an explicit warning to the student.
MAX_LLM_INPUT_CHARS=400000

# --- Resume generation (service/resume_generation.py) -------------------------
# Uses the same ANTHROPIC_API_KEY above. Unlike extraction there is no
# rule-based fallback: with the stage off or no key present,
# POST /api/resume/generate returns success=False and a student-facing warning.
RESUME_GENERATION_ENABLED=true

# Defaults to ANTHROPIC_MODEL when unset.
RESUME_MODEL=claude-opus-5
# Drafting from an already-structured profile is not deep reasoning. Sweep
# low/medium/high against real profiles before raising this — it runs on every
# "regenerate wording" click.
RESUME_EFFORT=medium
# Thinking plus response together, as above.
RESUME_MAX_TOKENS=16000
RESUME_TIMEOUT_SECONDS=120
RESUME_MAX_RETRIES=1
# Upper bound on the "regenerate wording" counter.
RESUME_MAX_VARIANT=9

# --- Frontend (frontend/) -----------------------------------------------------
# Serve the browser client from the same app as the API. Same origin means no
# CORS at all and no separate static server — the simplest way to run the whole
# product locally. Off by default because a real deploy should front the static
# files with something else.
SERVE_FRONTEND=false

# Comma-separated frontend origins for CORS. Only needed when SERVE_FRONTEND is
# false and the client is served from somewhere else. "*" is the development
# default and must not ship.
PATHFINDER_ALLOWED_ORIGINS=*

# Populated in later phases: Handshake (or other licensed feed) credentials once
# supplied.
